# Copy to src/api/.env (the API loads .env from its working directory)

OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# development (default): no limits, it's your key and your clicks
# production: per-IP + global daily limits, serves the built frontend from dist/
EPOCHE_ENV=development

# Production limits (ignored in development)
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
GLOBAL_DAILY_LIMIT=2000      # spending guard: total generations per UTC day
PROXIES_COUNT=1              # reverse proxies in front (Caddy/nginx) for real client IPs

# SQLite usage log (sessions/interactions, anonymous)
DATABASE_PATH=./oblique.db

PORT=8000
# HOST=127.0.0.1             # default in production; 0.0.0.0 in development
DEBUG=false

# Only needed if the frontend is hosted on a different origin than the API
# CORS_ORIGINS=https://example.netlify.app
# and then build the frontend with VITE_API_URL=https://api.example.com
